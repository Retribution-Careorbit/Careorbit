{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/health", "/assets/*", "*.css", "*.js", "*.png", "*.jpg", "*.svg", "*.ico"]
  },
  "routes": [
    {
      "route": "/health",
      "rewrite": "https://careorbit-api-dev.azurewebsites.net/health",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/api/*",
      "rewrite": "https://careorbit-api-dev.azurewebsites.net/api/*",
      "allowedRoles": ["anonymous", "authenticated"]
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
